# Docker Compose / production MAX Mini App (секрет хранится только на сервере)
MAX_BOT_TOKEN=
MAX_WEBAPP_AUTH=strict
MAX_INIT_DATA_MAX_AGE_SEC=3600
MAX_CONTACT_MAX_AGE_SEC=300
# Одноразовая загрузка первого администратора: номер MAX без пробелов, можно с +.
INITIAL_ADMIN_PHONE=

# API
API_PORT=8787
DATABASE_PATH=/app/data/barber.db
UPLOAD_DIR=/app/data/uploads
MAX_HOMEWORK_UPLOAD_MB=50
CHAT_ENABLED=true
APP_NOTIFICATIONS_RETENTION_DAYS=90
